{
    "servers": [
        {
            "server": {
                "name": "awslabs.aws-documentation-mcp-server",
                "title": "AWS Documentation",
                "description": "MCP server for AWS documentation search, reading, and recommendations",
                "version": "1.2.0",
                "packages": [
                    {
                        "registryType": "pypi",
                        "identifier": "awslabs.aws-documentation-mcp-server",
                        "transport": {
                            "type": "stdio"
                        },
                        "environmentVariables": [
                            {
                                "name": "FASTMCP_LOG_LEVEL",
                                "value": "ERROR"
                            },
                            {
                                "name": "AWS_DOCUMENTATION_PARTITION",
                                "value": "aws"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "server": {
                "name": "awslabs.aws-iac-mcp-server",
                "title": "AWS Infrastructure as Code",
                "description": "MCP server for AWS IaC: CloudFormation validation, CDK docs, and deployment help",
                "version": "1.0.26",
                "packages": [
                    {
                        "registryType": "pypi",
                        "identifier": "awslabs.aws-iac-mcp-server",
                        "transport": {
                            "type": "stdio"
                        },
                        "environmentVariables": [
                            {
                                "name": "FASTMCP_LOG_LEVEL",
                                "value": "ERROR"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "server": {
                "name": "awslabs.aws-knowledge-mcp-server",
                "title": "AWS Knowledge",
                "description": "Remote MCP server for AWS docs, code samples, agent skills, and regional availability",
                "version": "1.0.0",
                "remotes": [
                    {
                        "type": "streamable-http",
                        "url": "https://knowledge-mcp.global.api.aws"
                    }
                ]
            }
        }
    ]
}
